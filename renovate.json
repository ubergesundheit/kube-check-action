{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": {
    "enabled": true
  },
  "automerge": true,
  "platformAutomerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Kubernetes validation tools in action.yml",
      "managerFilePatterns": [
        "/(^|/)action\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) packageName=(?<packageName>\\S+)\\s+default:\\s*[\"']?(?<currentValue>[^\"'\\s]+)"
      ],
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>\\d+\\.\\d+\\.\\d+(?:[-+].*)?)$"
    },
    {
      "customType": "regex",
      "description": "Update Kubernetes version in tests",
      "managerFilePatterns": [
        "/(^|/)README\\.md$/",
        "/\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*.*kubernetes-version\\s+(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "kubernetes-version\\s+(?<currentValue>\\d+\\.\\d+\\.\\d+)\"?\\s*# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)"
      ],
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>\\d+\\.\\d+\\.\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Group Kubernetes validation tool updates",
      "matchPackageNames": [
        "kubernetes-sigs/kustomize",
        "yannh/kubeconform",
        "stackrox/kube-linter",
        "FairwindsOps/pluto"
      ],
      "groupName": "Kubernetes validation tools",
      "groupSlug": "kubernetes-validation-tools",
      "ignoreUnstable": true
    },
    {
      "description": "Automerge all PRs once CI is green",
      "matchPackageNames": [
        "*"
      ],
      "automerge": true
    }
  ]
}
